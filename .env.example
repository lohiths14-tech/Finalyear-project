# AgriVision AI — Environment Configuration
# Copy this file to backend/.env and fill in your values.

# ── API Security ───────────────────────────────────────────────
# Set to a long random string to require X-API-Key header on all inference endpoints.
# Leave empty to disable authentication (suitable for local development).
API_KEY=

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# BACKEND_CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# ── ML Device ─────────────────────────────────────────────────
# Set to "cuda" if a GPU is available for faster inference.
DEVICE=cpu

# ── File Upload ────────────────────────────────────────────────
# Maximum upload size in MB.
MAX_FILE_SIZE_MB=10

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_DIR=/var/log/agrivision   # Uncomment for Docker persistent logging

# ── Model Weights ─────────────────────────────────────────────
# Directory containing trained .pt files (generated by scripts/train_synthetic.py).
MODEL_BASE_PATH=./model_weights

# ── Grounded Agronomic Decision Engine (Optional APIs) ────────
# Optional: Set Google Gemini or OpenAI API keys.
# If empty, automatically falls back to internal deterministic ICAR RAG engine.
GEMINI_API_KEY=
OPENAI_API_KEY=
